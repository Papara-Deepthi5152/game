import random

class PlayfairEngine:
    def __init__(self, key: str):
        self.key = key.upper().replace('J', 'I')
        self.matrix = self._build_matrix()
        self.pos_dict = {self.matrix[r][c]: (r, c) for r in range(5) for c in range(5)}

    def _build_matrix(self):
        alphabet = "ABCDEFGHIKLMNOPQRSTUVWXYZ"
        used = []
        for char in self.key + alphabet:
            if char.isalpha() and char not in used:
                used.append(char)
        return [used[i:i+5] for i in range(0, 25, 5)]

    def print_matrix(self):
        print("\n--- 5x5 PLAYFAIR KEY MATRIX ---")
        for r, row in enumerate(self.matrix):
            print(f"  Row {r}:  " + "  ".join(row))
        print("-------------------------------\n")

    def _prepare_cipher_pairs(self, raw_c: str):
        clean = "".join([c.upper() for c in raw_c if c.isalpha()]).replace('J', 'I')
        if len(clean) % 2 != 0:
            clean += 'X'
        return [clean[k:k+2] for k in range(0, len(clean), 2)]

    def decrypt_with_steps(self, ciphertext: str):
        c_pairs = self._prepare_cipher_pairs(ciphertext)
        plaintext_pairs = []

        print("=" * 65)
        print(" 🔓 STEP-BY-STEP DECRYPTION CONVERSION PROCESS")
        print("=" * 65)

        for idx, pair in enumerate(c_pairs, 1):
            a, b = pair[0], pair[1]
            r1, c1 = self.pos_dict[a]
            r2, c2 = self.pos_dict[b]

            if r1 == r2:
                dec_a = self.matrix[r1][(c1 - 1) % 5]
                dec_b = self.matrix[r2][(c2 - 1) % 5]
                rule = "Same Row -> Shift Left"
            elif c1 == c2:
                dec_a = self.matrix[(r1 - 1) % 5][c1]
                dec_b = self.matrix[(r2 - 1) % 5][c2]
                rule = "Same Column -> Shift Up"
            else:
                dec_a = self.matrix[r1][c2]
                dec_b = self.matrix[r2][c1]
                rule = "Rectangle Rule -> Swap opposite horizontal corners"

            p_pair = dec_a + dec_b
            plaintext_pairs.append(p_pair)
            print(f"Pair {idx:02d} [{a}{b}]: Pos('{a}')=(R{r1},C{c1}), Pos('{b}')=(R{r2},C{c2})")
            print(f"        └ Rule: {rule} ---> Decrypted Pair: [{p_pair}]")

        print("=" * 65)
        return "".join(plaintext_pairs), plaintext_pairs

    def re_encrypt_pairs(self, plaintext_pairs: list):
        ciphertext_pairs = []

        print("=" * 65)
        print(" 🔒 STEP-BY-STEP ENCRYPTION CONVERSION PROCESS")
        print("=" * 65)

        for idx, pair in enumerate(plaintext_pairs, 1):
            a, b = pair[0], pair[1]
            r1, c1 = self.pos_dict[a]
            r2, c2 = self.pos_dict[b]

            if r1 == r2:
                enc_a = self.matrix[r1][(c1 + 1) % 5]
                enc_b = self.matrix[r2][(c2 + 1) % 5]
                rule = "Same Row -> Shift Right"
            elif c1 == c2:
                enc_a = self.matrix[(r1 + 1) % 5][c1]
                enc_b = self.matrix[(r2 + 1) % 5][c2]
                rule = "Same Column -> Shift Down"
            else:
                enc_a = self.matrix[r1][c2]
                enc_b = self.matrix[r2][c1]
                rule = "Rectangle Rule -> Swap opposite horizontal corners"

            c_pair = enc_a + enc_b
            ciphertext_pairs.append(c_pair)
            print(f"Pair {idx:02d} [{a}{b}]: Pos('{a}')=(R{r1},C{c1}), Pos('{b}')=(R{r2},C{c2})")
            print(f"        └ Rule: {rule} ---> Encrypted Pair: [{c_pair}]")

        full_ciphertext = " ".join(ciphertext_pairs)
        print("=" * 65)
        return full_ciphertext


